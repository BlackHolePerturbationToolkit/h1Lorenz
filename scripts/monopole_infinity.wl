(* Generate src/monopole_infinity.c: the expansion at infinity of the static monopole outside the
   orbit (static_monopole.c), h_i = sum_n (b_n + c_n log r)/r^n, i = 1, 3, 6, as functions of r0.
   Usage: WolframKernel -script scripts/monopole_infinity.wl *)
root = DirectoryName[$InputFileName] // ParentDirectory;
K = 12;
h1 = (4 Sqrt[Pi] (-2 (-8 + r0) (-4 + r0) - 6 r^2 (-3 + r0) + 4 r^3 (-3 + r0) + 2 r (20 + (-8 + r0) r0) - (-4 + r) r^3 (-3 + r0) Log[(-2 + r)/r] + 16 (-1 + r) (-3 + r0) Log[r0/(-2 + r)]))/(3 r^3 Sqrt[(-3 + r0) r0]);
h3 = (-8 Sqrt[Pi] (32 + 3 r (4 + r) - 12 r0 - r (4 + r) r0 + r0^2 + r^3 (-3 + r0) Log[(-2 + r)/r] + 8 (-3 + r0) Log[r0/(-2 + r)]))/(3 r^2 Sqrt[(-3 + r0) r0]);
h6 = (4 Sqrt[Pi] (-2 (-8 + r0) (-4 + r0) + 8 r (-3 + r0) + 2 r^2 (-3 + r0) + r^3 (-3 + r0) Log[(-2 + r)/r] + 16 (-3 + r0) Log[(-2 + r)/r0]))/(3 r^2 Sqrt[(-3 + r0) r0]);
(* log(r0/(r - 2)) = log r0 - log r - log(1 - 2/r) etc.: expand in y = 1/r with Lr = log r *)
ser[h_] := Module[{e = h /. {Log[r0/(-2 + r)] -> Log[r0] - Lr - Log[1 - 2/r], Log[(-2 + r)/r0] -> Lr + Log[1 - 2/r] - Log[r0], Log[(-2 + r)/r] -> Log[1 - 2/r]} /. r -> 1/y, s},
   s = Normal[Series[e, {y, 0, K - 1}]];
   Table[{Simplify[Coefficient[s, y, n] /. Lr -> 0], Simplify[Coefficient[Coefficient[s, y, n], Lr]]}, {n, 0, K - 1}]];
cs = ser /@ {h1, h3, h6};
If[! FreeQ[cs, Lr | y], Print["unexpanded terms left"]; Abort[]];
code = StringJoin[
  "/* Generated by scripts/monopole_infinity.wl: expansion at infinity of the static monopole outside\n",
  " * the orbit (static_monopole.c), h_i = sum_n (b[k][n] + c[k][n] log r)/r^n for i = 1, 3, 6 (k = 0, 1, 2),\n",
  " * n < ", ToString[K], ". */\n#include <math.h>\n\nvoid monopole_infinity_series(double r0, double b[3][", ToString[K], "], double c[3][", ToString[K], "])\n{\n",
  "  const double Pi = M_PI;\n",
  StringJoin[Table["  b[" <> ToString[k - 1] <> "][" <> ToString[n - 1] <> "] = " <> ToString[CForm[N[cs[[k, n, 1]], 20]]] <> ";\n" <>
     "  c[" <> ToString[k - 1] <> "][" <> ToString[n - 1] <> "] = " <> ToString[CForm[N[cs[[k, n, 2]], 20]]] <> ";\n", {k, 3}, {n, K}]],
  "}\n"];
code = StringReplace[code, {"Power(" -> "pow(", "Sqrt(" -> "sqrt(", "Log(" -> "log("}];
Export[FileNameJoin[{root, "src", "monopole_infinity.c"}], code, "Text"];
Print["wrote src/monopole_infinity.c"];
